# ==========================================
# VARIÁVEIS DE AMBIENTE - PORTAL FATEC RIO CLARO
# Responsáveis: Cesar (Backend & Segurança) e Guilherme (DevOps, IA & QA)
# ==========================================

# 1. Configuração do Servidor e Hospedagem (Vercel)
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_ENV=development

# 2. Chave Secreta para Assinatura JWT (mínimo de 32 caracteres criptograficamente seguros)
JWT_SECRET=fatec_rio_claro_super_secure_jwt_secret_key_2026_cesar_dev_token
JWT_EXPIRES_IN=7d

# 3. Conexão com o Banco de Dados PostgreSQL (Supabase Cloud)
# Pooler Transacional (Porta 6543 - Recomendado para Serverless na Vercel):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Conexão Direta (Porta 5432 - Utilizada para Migrations e Seeds):
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Chaves de API do Projeto Supabase (Storage de Comprovantes / Apostilas e Auth Auxiliar)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sua_chave_anon_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sua_chave_service_role_secreta_aqui

# Modo de Desenvolvimento Offline (Permite testes rápidos sem banco externo ativo)
USE_MOCK_DB=true

# 4. Inteligência Artificial — Google Gemini SDK (OCR de Comprovantes Pix e Assistente Acadêmico)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_api_google_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.2
USE_MOCK_AI=true

# 5. Configuração da Chave Pix do Centro Acadêmico (Honest Market)
PIX_KEY=cantina.fatec.rc@fatec.sp.gov.br
PIX_BENEFICIARY_NAME=Centro Academico Fatec Rio Claro
PIX_CITY=RIO CLARO
