# ==========================================
# VARIÁVEIS DE AMBIENTE - PORTAL FATEC RIO CLARO
# Responsável: Cesar (Backend & Segurança)
# ==========================================

# Configuração do Servidor
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave Secreta para Assinatura JWT (mínimo de 32 caracteres criptograficamente seguros)
JWT_SECRET=fatec_rio_claro_super_secure_jwt_secret_key_2026_cesar_dev_token
JWT_EXPIRES_IN=7d

# Conexão com o Banco de Dados PostgreSQL (Local ou Nuvem / Supabase / Neon)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fatec_portal

# Modo de Desenvolvimento Offline (Permite testes rápidos sem banco local rodando)
USE_MOCK_DB=true

# Configuração da Chave Pix do Centro Acadêmico (Honest Market)
PIX_KEY=cantina.fatec.rc@fatec.sp.gov.br
PIX_BENEFICIARY_NAME=Centro Academico Fatec Rio Claro
PIX_CITY=RIO CLARO
