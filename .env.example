# ==============================================================================
# PORTAL INTEGRADO FATEC RIO CLARO — VARIÁVEIS DE AMBIENTE (.env.example)
# Responsável DevOps, IA & QA: Guilherme
# Copie este arquivo para ".env.local" no ambiente de desenvolvimento local
# e configure as chaves correspondentes no painel da Vercel e Supabase.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE DE EXECUÇÃO E APLICAÇÃO (VERCEL / NEXT.JS)
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Portal Integrado FATEC Rio Claro"

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (SUPABASE CLOUD POSTGRESQL & MODO HÍBRIDO)
# ------------------------------------------------------------------------------
# Defina USE_MOCK_DB="true" para rodar com banco em memória (sem necessidade de internet/banco externo)
# Na Vercel (Produção), defina USE_MOCK_DB="false"
USE_MOCK_DB="true"

# String de conexão via Connection Pooler (Supavisor - Porta 6543) recomendada para Serverless (Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# String de conexão direta (Porta 5432) utilizada para scripts de migração (npm run db:migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Chaves de API do Projeto Supabase (Configurações -> API no Dashboard do Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sua_chave_anon_publica"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sua_chave_service_role_secreta"

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E AUTENTICAÇÃO (JWT & SESSÃO HTTP-ONLY)
# ------------------------------------------------------------------------------
# Gere um segredo forte de no mínimo 64 caracteres (ex: openssl rand -hex 32)
JWT_SECRET="fatec_rio_claro_super_secure_jwt_secret_key_2026_production_ready"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI SDK — OCR PIX & ASSISTENTE)
# ------------------------------------------------------------------------------
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGoogleGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MOCK="true"

# ------------------------------------------------------------------------------
# 5. CANTINA DISCENTE (CONFIGURAÇÃO PIX PADRÃO EMV BANCO CENTRAL)
# ------------------------------------------------------------------------------
PIX_KEY_CA="ca.fatec.rioclaro@cps.sp.gov.br"
PIX_MERCHANT_NAME="CA FATEC RIO CLARO"
PIX_MERCHANT_CITY="RIO CLARO"
